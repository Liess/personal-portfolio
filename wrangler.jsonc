{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/oauth", "/callback", "/admin/config.yml", "/admin/config.yaml"]
  },
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liME667BO7Shmth0"
  }
}
